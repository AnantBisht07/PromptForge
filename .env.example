# Copy this file to .env and fill in your values

# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# SQLite (local dev — no setup needed):
DATABASE_URL=sqlite:///./promptforge.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@localhost:5432/promptforge

# Qdrant vector database
# Run locally with Docker: docker run -p 6333:6333 qdrant/qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=prompts
EMBEDDING_DIM=384

# Evaluation engine (both are optional — leave empty to use mock LLM + no tracing)
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# LangSmith: https://smith.langchain.com — create a project named "promptforge-eval"
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=promptforge-eval
