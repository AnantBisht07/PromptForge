# Copy this file to .env and fill in your values.

# Generate a strong secret:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-strong-random-secret

# JWT settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database
# Local backend dev can use SQLite.
DATABASE_URL=sqlite:///./promptforge.db
SQL_ECHO=false

# Local backend with Docker Postgres:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/promptforge

# Docker Compose injects this inside the api container:
# postgresql://postgres:password@postgres:5432/promptforge
POSTGRES_PASSWORD=password
POSTGRES_DB=promptforge

# Qdrant vector database
# Local backend with Compose Qdrant should use localhost:6433.
# Docker Compose injects qdrant:6333 inside the api container.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=prompts
EMBEDDING_DIM=384

# Streamlit frontend
# Local Streamlit should call the host-mapped backend.
# Docker Compose sets this to http://api:8000 inside the frontend container.
PROMPTFORGE_API_URL=http://localhost:8000

# Evaluation engine
# Leave empty to use mock LLM output and no LangSmith tracing.
OPENAI_API_KEY=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=promptforge-eval
